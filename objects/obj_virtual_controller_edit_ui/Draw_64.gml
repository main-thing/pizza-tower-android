draw_sprite(spr_button_save, 0, x + 256, y + 32);
draw_sprite(spr_button_load, 0, x + 320, y + 32);
draw_sprite(spr_button_close_controls_edit, 0, x + VKEY_EDIT_UI_WIDTH, y);
