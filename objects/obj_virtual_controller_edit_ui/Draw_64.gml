ADD_OBJECT_EVENT_GML_HOOK;
draw_self();
draw_set_alpha(0.5);
draw_set_color(c_black);
draw_rectangle(x, y, x + VKEY_EDIT_UI_WIDTH, y + 64, false);
draw_set_color(c_white);
