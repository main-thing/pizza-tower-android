function struct_create()
{
	return {};
}

function call_alarm(alarmid,delay,instance = noone) {
	if(instance_exists(instance)) {
		instance.alarm[alarmid] = delay
	} else {
		alarm[alarmid] = delay
	}
}

function set_view_surface(_id, surf)
{
	view_surface_id[_id] = surf
}

function state_get_name(state)
{
	for(var i = 0, _states = variable_struct_get_names(states); i < variable_struct_names_count(states); i++)
	{
		var _state = _states[i];
		if(states[$ _state] == state)
			return _state;
	}
}

function pause_option(_text, _spr = noone, _func = noone) constructor
{
    text = _text;
	spr = _spr;
    func = _func;
} 

#macro sprite_get_height_old sprite_get_height
#macro sprite_get_height sprite_get_height_replacement
function sprite_get_height_replacement(a)
{
	return sprite_exists(a) ? sprite_get_height_old(a) : -1;
}

#macro sprite_get_width_old sprite_get_width
#macro sprite_get_width sprite_get_width_replacement
function sprite_get_width_replacement(a)
{
	return sprite_exists(a) ? sprite_get_width_old(a) : -1;
} 

if(PRE_2023_GM)
{
	// not ideal
	function array_contains(array, value)
	{
		var list = ds_list_from_array(array);
		var retval = ds_list_find_index(list, value) != -1;
		ds_list_destroy(list);
		return retval;
	}
	
	function array_get_index(value, array)
	{
		var list = ds_list_from_array(array);
		var retval = ds_list_find_index(list, value);
		ds_list_destroy(list);
		return retval;
	}
}

function get_ptem_data_folder()
{
	if(os_type == os_android)
	{
		var temp = string_split(game_save_id, "/", true)
		var first_index = array_get_index("data", temp)
		return "/storage/emulated/" + temp[first_index + 2] + "/android/media/" + temp[first_index + 3] + "/"
	}
}


